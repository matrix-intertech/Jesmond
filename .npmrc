# Hoist NestJS packages to root node_modules so TypeScript can resolve them
# in clean Docker builds regardless of pnpm's virtual store structure.
# NestJS packages lack an "exports" map, making them incompatible with
# pnpm's default isolated linker under strict moduleResolution: nodenext.
public-hoist-pattern[]=@nestjs/*
public-hoist-pattern[]=reflect-metadata
