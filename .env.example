# Service Provider Appointments
MSG91_TPL_SERVICE_PROVIDER_NEW_APPOINTMENT=jesmond_sp_new_appointment
MSG91_TPL_SERVICE_PROVIDER_NEW_APPOINTMENT_STATUS=PENDING_APPROVAL
MSG91_TPL_SERVICE_PROVIDER_APPOINTMENT_CONFIRMED=jesmond_sp_appointment_confirmed
