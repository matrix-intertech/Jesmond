# ==========================================
# BACKEND (NestJS & Prisma)
# ==========================================
DATABASE_URL="postgresql://jesmond_app:<PASSWORD>@localhost:5432/jesmond?schema=public"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET=""
# Microsoft 365 SMTP
# Note: SMTP_USER and SMTP_PASSWORD must contain the Microsoft 365 mailbox credentials/app password or approved SMTP authentication credentials.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ==========================================
# STORAGE (Cloudflare R2)
# ==========================================
S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_PUBLIC_URL=""

# ==========================================
# FRONTEND (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_R2_PUBLIC_URL=""

# ==========================================
# MSG91 WhatsApp Integration (Jesmond)
# ==========================================
# Dedicated Jesmond MSG91 Auth Key (do not reuse MatrixSpaces credentials)
MSG91_AUTH_KEY=
# Australian WhatsApp Business Number (+614... format without leading +)
MSG91_WHATSAPP_SENDER=
# Outbound bulk endpoint URL
MSG91_WHATSAPP_BASE_URL=https://control.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/
# Master kill-switch flag
MSG91_WHATSAPP_ENABLED=false
# Optional Meta/Facebook WhatsApp Business Account namespace
MSG91_WHATSAPP_NAMESPACE=
# Default language code for templates (e.g. en)
MSG91_WHATSAPP_DEFAULT_LANG=en
# Outbound HTTP request timeout in milliseconds
MSG91_TIMEOUT_MS=10000

# WhatsApp Template Identifiers & Approval Status (Configured per event)
# Auth
MSG91_TPL_AUTH_REGISTER_OTP=jesmond_auth_register_otp
MSG91_TPL_AUTH_REGISTER_OTP_STATUS=PENDING_APPROVAL
MSG91_TPL_AUTH_LOGIN_OTP=jesmond_auth_login_otp
MSG91_TPL_AUTH_LOGIN_OTP_STATUS=PENDING_APPROVAL
MSG91_TPL_AUTH_PASSWORD_RESET_OTP=jesmond_auth_password_reset_otp
MSG91_TPL_AUTH_PASSWORD_RESET_OTP_STATUS=PENDING_APPROVAL

# Orders
MSG91_TPL_ORDER_CONFIRMED=jesmond_order_confirmed
MSG91_TPL_ORDER_CONFIRMED_STATUS=PENDING_APPROVAL
MSG91_TPL_ORDER_PACKED=jesmond_order_packed
MSG91_TPL_ORDER_PACKED_STATUS=PENDING_APPROVAL
MSG91_TPL_ORDER_DELIVERED=jesmond_order_delivered
MSG91_TPL_ORDER_DELIVERED_STATUS=PENDING_APPROVAL
MSG91_TPL_ORDER_TAKEN_AWAY=jesmond_order_taken_away
MSG91_TPL_ORDER_TAKEN_AWAY_STATUS=PENDING_APPROVAL

# Properties
MSG91_TPL_PROPERTY_LISTING_CONFIRMED=jesmond_property_listing_confirmed
MSG91_TPL_PROPERTY_LISTING_CONFIRMED_STATUS=PENDING_APPROVAL
MSG91_TPL_PROPERTY_QUERY_RECEIVED=jesmond_property_query_received
MSG91_TPL_PROPERTY_QUERY_RECEIVED_STATUS=PENDING_APPROVAL
MSG91_TPL_PROPERTY_MESSAGE_RECEIVED=jesmond_property_message_received
MSG91_TPL_PROPERTY_MESSAGE_RECEIVED_STATUS=PENDING_APPROVAL

# Customer Appointments
MSG91_TPL_APPOINTMENT_REQUEST_RECEIVED=jesmond_appointment_request_received
MSG91_TPL_APPOINTMENT_REQUEST_RECEIVED_STATUS=PENDING_APPROVAL
MSG91_TPL_APPOINTMENT_CONFIRMED=jesmond_appointment_confirmed
