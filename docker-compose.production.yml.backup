version: '3.8'

services:
  jesmond-api:
    build:
      context: .
      dockerfile: apps/api/Dockerfile
    container_name: jesmond-api
    restart: unless-stopped
    ports:
      # Exposing to 3001 locally, Nginx will proxy to localhost:3001
      - "127.0.0.1:3001:3001"
    env_file:
      - .env.production
    environment:
      - NODE_ENV=production
    networks:
      - jesmond-network

  jesmond-web:
    build:
      context: .
      dockerfile: apps/web/Dockerfile
    container_name: jesmond-web
    restart: unless-stopped
    ports:
      # Exposing to 3000 locally, Nginx will proxy to localhost:3000
      - "127.0.0.1:3000:3000"
    env_file:
      - .env.production
    environment:
      - NODE_ENV=production
    networks:
      - jesmond-network
    depends_on:
      - jesmond-api

networks:
  jesmond-network:
    driver: bridge
