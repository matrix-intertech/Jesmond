# ==========================================
# Jesmond Production Environment Template
# ==========================================
# IMPORTANT: DO NOT commit your actual .env.production file.

NODE_ENV=production

# Database (Neon DB or standard Postgres)
DATABASE_URL=

# Authentication (Generate a strong random string)
JWT_SECRET=

# CORS - Must exactly match your frontend domain
CORS_ORIGIN=https://jesmond.matrixspaces.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# Cloudflare R2 Storage
# ==========================================
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_PUBLIC_URL=

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_API_URL=https://jesmondapi.matrixspaces.com
NEXT_PUBLIC_R2_PUBLIC_URL=
