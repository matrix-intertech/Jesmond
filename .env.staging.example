# ==========================================
# BACKEND (NestJS & Prisma)
# ==========================================
DATABASE_URL="postgresql://jesmond_app:<PASSWORD>@jesmond-staging-db:5432/jesmond_staging?schema=public"
REDIS_HOST="jesmond-staging-redis"
REDIS_PORT="6379"
REDIS_PASSWORD=""
CORS_ORIGIN="http://localhost:3302"
JWT_SECRET="<STAGING_JWT_SECRET>"
# Mock SMTP for staging, do not send real emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=test
SMTP_PASSWORD=test
EMAIL_FROM=staging@example.com

# ==========================================
# STORAGE (Cloudflare R2)
# ==========================================
S3_BUCKET="staging-bucket"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
R2_ACCOUNT_ID="test"
R2_PUBLIC_URL="http://localhost:3303"

# ==========================================
# FRONTEND (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:3303"
NEXT_PUBLIC_R2_PUBLIC_URL="http://localhost:3303"
NEXT_PUBLIC_SITE_URL="http://localhost:3302"
NEXT_PUBLIC_APP_ENV="staging"
