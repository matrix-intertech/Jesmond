version: '3.8'

services:
  jesmond-redis:
    image: redis:7-alpine
    container_name: jesmond-redis
    restart: unless-stopped
    command: redis-server --appendonly yes
    volumes:
      - jesmond-redis-data:/data
    networks:
      - jesmond-network

  jesmond-api:
jesmond-web:
  build:
    context: .
    dockerfile: apps/web/Dockerfile
    args:
      NEXT_PUBLIC_API_URL: https://jesmondapi.matrixspaces.com
      NEXT_PUBLIC_R2_PUBLIC_URL: https://pub-a858d2d933774b55b48ab730707eac3d.r2.dev
  container_name: jesmond-web
    restart: unless-stopped
    ports:
      - "127.0.0.1:3301:3001"
    env_file:
      - .env.production
    environment:
      NODE_ENV: production
      REDIS_HOST: jesmond-redis
      REDIS_PORT: 6379
    depends_on:
      - jesmond-redis
    networks:
      - jesmond-network

  jesmond-web:
    build:
      context: .
      dockerfile: apps/web/Dockerfile
    container_name: jesmond-web
    restart: unless-stopped
    ports:
      - "127.0.0.1:3300:3000"
    environment:
      NODE_ENV: production
      NEXT_PUBLIC_API_URL: https://jesmondapi.matrixspaces.com
      NEXT_PUBLIC_R2_PUBLIC_URL: https://pub-a858d2d933774b55b48ab730707eac3d.r2.dev
    depends_on:
      - jesmond-api
    networks:
      - jesmond-network

networks:
  jesmond-network:
    external: true

volumes:
  jesmond-redis-data:
    external: true
